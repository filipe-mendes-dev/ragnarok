{
  "name": "@ragnarok/job-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "npm run build && (npm run dev:panel & npm run dev:scripts & wait)",
    "dev:panel": "vite build --watch --base=./",
    "dev:scripts": "esbuild content-script=src/content/application/entry.ts context-script=src/content/context-entry.ts service-worker=src/background/entry.ts --bundle --format=esm --target=chrome120 --outdir=dist --watch",
    "build": "vite build --base=./ --emptyOutDir && npm run build:scripts",
    "build:scripts": "esbuild content-script=src/content/application/entry.ts context-script=src/content/context-entry.ts service-worker=src/background/entry.ts --bundle --format=esm --target=chrome120 --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-types": "^0.1.450",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
