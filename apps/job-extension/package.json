{
  "name": "@ragnarok/job-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "npm run build && (npm run dev:popup & npm run dev:content & wait)",
    "dev:popup": "vite build --watch --base=./",
    "dev:content": "esbuild src/content/entry.ts --bundle --format=esm --target=chrome120 --outfile=dist/content-script.js --watch",
    "build": "vite build --base=./ --emptyOutDir && npm run build:content",
    "build:content": "esbuild src/content/entry.ts --bundle --format=esm --target=chrome120 --outfile=dist/content-script.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-types": "^0.1.450",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
