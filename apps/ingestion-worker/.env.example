# Match the web app's database and ingestion queues.
DATABASE_URL=postgresql://ragnarok:ragnarok_dev_password@localhost:5432/ragnarok
RABBITMQ_URL=amqp://ragnarok:ragnarok_dev_password@localhost:5672/
INGESTION_QUEUE_NAME=ragnarok.ingestion.v1
INGESTION_REJECTED_QUEUE_NAME=ragnarok.ingestion.rejected.v1

# Document embeddings
OPENROUTER_API_KEY=
# OPENROUTER_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings

# Local S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ragnarok-documents
S3_ACCESS_KEY_ID=ragnarok
S3_SECRET_ACCESS_KEY=ragnarok_dev_secret
S3_FORCE_PATH_STYLE=true
PDF_MAX_UPLOAD_SIZE_BYTES=10485760
# PDF_MAX_PAGES=300
# PDF_MAX_EXTRACTED_CHARACTERS=1000000
