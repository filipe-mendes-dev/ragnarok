# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/web/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/web/coverage/

# next.js
/.next/
/out/
/apps/web/.next/
/apps/web/out/

# production
/build
/apps/web/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python worker
**/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
**/.pytest_cache/
/apps/ingestion-worker/models/
/apps/ingestion-worker/benchmarks/runs/
/apps/ingestion-worker/benchmarks/evaluation-results/
/apps/ingestion-worker/benchmarks/corpus/full/*.pdf
