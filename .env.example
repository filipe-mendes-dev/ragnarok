# Local PostgreSQL
POSTGRES_DB=ragnarok
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=ragnarok_dev_password
DATABASE_URL=postgresql://ragnarok:ragnarok_dev_password@localhost:5432/ragnarok

# Local RabbitMQ. The worker runs on the host, so it uses localhost.
RABBITMQ_USER=ragnarok
RABBITMQ_PASSWORD=ragnarok_dev_password
RABBITMQ_URL=amqp://ragnarok:ragnarok_dev_password@localhost:5672/

# Shared by the web publisher and Python worker.
INGESTION_QUEUE_NAME=ragnarok.ingestion.v1
INGESTION_REJECTED_QUEUE_NAME=ragnarok.ingestion.rejected.v1

# Optional worker override; defaults to worker/models/bge-small-en-v1.5.
# Provision the pinned model using worker/README.md before starting the worker.
# EMBEDDING_MODEL_DIR=/absolute/path/to/bge-small-en-v1.5

# Both Next.js and the ingestion worker call this single resident model service.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8081
# Embedding server defaults. Bind to a private interface only in deployment.
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081

# Required when generating chat answers. Choose a model slug after creating an OpenRouter account.
OPENROUTER_API_KEY=
GENERATION_MODEL=

# Authentication
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ragnarok-documents
S3_ACCESS_KEY_ID=ragnarok
S3_SECRET_ACCESS_KEY=ragnarok_dev_secret
S3_FORCE_PATH_STYLE=true
S3_CORS_ALLOWED_ORIGIN=http://localhost:3000
PDF_MAX_UPLOAD_SIZE_BYTES=10485760
# Optional PDF policy limits; unset means no page/total-character ceiling.
# PDF_MAX_PAGES=300
# PDF_MAX_EXTRACTED_CHARACTERS=1000000
