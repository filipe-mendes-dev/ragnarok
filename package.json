{
    "name": "ragnarok",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "volta": {
        "node": "24.20.0",
        "npm": "11.6.2"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:watch": "vitest --project unit",
        "infra:up": "docker compose -f compose.dev.yml up -d",
        "infra:down": "docker compose -f compose.dev.yml down",
        "infra:logs": "docker compose -f compose.dev.yml logs -f",
        "infra:status": "docker compose -f compose.dev.yml ps",
        "auth:schema": "auth generate --config ./src/server/auth/auth.ts --output ./src/server/db/schema/auth.ts --yes",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "check": "npm run lint && npm run typecheck && npm run test && npm run test:integration"
    },
    "dependencies": {
        "better-auth": "^1.7.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "next": "16.3.4",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@testcontainers/postgresql": "^12.1.0",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "auth": "^1.7.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.3.4",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.11"
    }
}
